# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# App data (settings, DB, thumbnail cache). The glob covers side instances too
# — data-preview/ for the dev preview, data-8050/ and friends for extra ports —
# each of which holds a full library database that must never be committed.
data/
data-*/

# OS / editor / local tooling
.DS_Store
.idea/
.vscode/
# Claude Code's preview-server config: local dev scaffolding (ports, data dir),
# same category as .vscode/. Other .claude/ files can still be committed if a
# project ever wants to share them.
.claude/launch.json

# Codex/gstack scratch
.gstack/
